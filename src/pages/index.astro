---
import Layout from '../layouts/Layout.astro';

const practices = [
  {
    num: '01',
    name: 'Software as a Service',
    desc: 'Scalable, cloud-native platforms engineered for performance — from MVP to enterprise-grade SaaS.',
  },
  {
    num: '02',
    name: 'Music & Artist Unit',
    desc: 'Artist development, production, and digital distribution. Where sound meets technology.',
  },
  {
    num: '03',
    name: 'Photographic Brand',
    desc: 'Visual storytelling through commercial and editorial photography. Image as identity.',
  },
  {
    num: '04',
    name: 'Graphic Design',
    desc: 'Brand systems, typography, and editorial design. Structure and form in every detail.',
  },
];

const works = [
  { tag: 'SaaS Platform', title: 'Meridian — Project Intelligence', seed: 'meridian-arch' },
  { tag: 'Music & Artist', title: 'Nocturne Records — Label System', seed: 'nocturne-music' },
  { tag: 'Photography', title: 'Aperture — Visual Archive', seed: 'aperture-photo' },
  { tag: 'Graphic Design', title: 'Form & Press — Identity Suite', seed: 'form-press-design' },
];
---

<Layout>
  <!-- ─── Navigation ─── -->
  <nav class="nav">
    <a href="#" class="nav-logo">VISUAL<span>GV</span></a>
    <ul class="nav-links">
      <li><a href="#practice">Practice</a></li>
      <li><a href="#philosophy">Philosophy</a></li>
      <li><a href="#works">Works</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <a href="#contact" class="nav-cta">Inquire</a>
  </nav>

  <!-- ─── Hero ─── -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <span class="eyebrow reveal">New York · Est. 2026</span>
        <h1 class="display display-xl hero-title reveal">
          We build the<br />
          structures of<br />
          the <em style="color: var(--accent); font-style: italic;">digital</em> age.
        </h1>
        <p class="lead reveal">
          VISUALGV is a creative technology studio operating at the intersection of
          software, music, photography, and design — a multidisciplinary practice
          with the rigor of an architecture firm and the speed of a startup.
        </p>
        <div class="hero-meta reveal">
          <div class="hero-meta-item">
            Practice<strong>Four Disciplines</strong>
          </div>
          <div class="hero-meta-item">
            Approach<strong>Design-Led Engineering</strong>
          </div>
          <div class="hero-meta-item">
            Based In<strong>New York, NY</strong>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-scroll">Scroll</div>
  </section>

  <!-- ─── Practice Areas ─── -->
  <section id="practice">
    <div class="container">
      <div class="index-header reveal">
        <div>
          <span class="eyebrow">What We Do</span>
          <h2 class="display display-lg">Practice Areas</h2>
        </div>
        <p style="color: var(--fg-dim); font-size: 0.85rem; max-width: 30ch;">
          Four disciplines, one studio. Each unit operates independently yet
          shares a common foundation of craft.
        </p>
      </div>
      <div class="index-grid">
        {practices.map((p) => (
          <div class="practice reveal">
            <div class="practice-num">{p.num}</div>
            <div class="practice-name">{p.name}</div>
            <div class="practice-desc">{p.desc}</div>
            <div class="practice-arrow">→</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Philosophy ─── -->
  <section id="philosophy" class="philosophy">
    <div class="container">
      <div class="philosophy-grid">
        <div class="philosophy-text reveal">
          <span class="eyebrow">Philosophy</span>
          <h2 class="display display-lg" style="margin-bottom: 2rem;">
            Discipline<br />meets <em style="color: var(--accent); font-style: italic;">imagination</em>.
          </h2>
          <p>
            We approach every project the way a skyscraper architect approaches
            a tower — with structural integrity, material honesty, and an
            obsession with proportion. Software is architecture. Music is
            architecture. A photograph is architecture. Each must stand on its
            own, bear its own weight, and last.
          </p>
          <p>
            VISUALGV was founded on the belief that the best creative work
            emerges not from a single discipline, but from the tension between
            many. Our SaaS practice informs our design. Our music informs our
            software. Our photography informs our brand work. Everything is
            connected. Everything is built.
          </p>
        </div>
        <div class="reveal">
          <div class="philosophy-stats">
            <div class="stat">
              <div class="stat-num">04</div>
              <div class="stat-label">Disciplines</div>
            </div>
            <div class="stat">
              <div class="stat-num">∞</div>
              <div class="stat-label">Iterations</div>
            </div>
            <div class="stat">
              <div class="stat-num">100%</div>
              <div class="stat-label">In-House</div>
            </div>
            <div class="stat">
              <div class="stat-num">01</div>
              <div class="stat-label">Standard</div>
            </div>
          </div>
          <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line);">
            <p style="color: var(--fg-dim); font-size: 0.9rem; line-height: 1.7;">
              "We don't decorate. We construct. Every pixel, every note, every
              line of code is load-bearing."
            </p>
            <p style="color: var(--accent); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; margin-top: 1rem;">
              — Studio Manifesto
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Selected Works ─── -->
  <section id="works">
    <div class="container">
      <div class="index-header reveal">
        <div>
          <span class="eyebrow">Portfolio</span>
          <h2 class="display display-lg">Selected Works</h2>
        </div>
        <p style="color: var(--fg-dim); font-size: 0.85rem; max-width: 30ch;">
          A cross-section of recent projects across all four practice areas.
        </p>
      </div>
      <div class="works-grid">
        {works.map((w) => (
          <div class="work reveal">
            <img
              class="work-image"
              src={`https://picsum.photos/seed/${w.seed}/800/600`}
              alt={w.title}
              loading="lazy"
            />
            <div class="work-overlay">
              <div class="work-tag">{w.tag}</div>
              <div class="work-title">{w.title}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Contact ─── -->
  <section id="contact" class="contact">
    <div class="container">
      <span class="eyebrow reveal">Begin</span>
      <h2 class="display display-xl reveal" style="margin-bottom: 1.5rem;">
        Let's build<br />
        something <em style="color: var(--accent); font-style: italic;">enduring</em>.
      </h2>
      <p class="lead reveal" style="margin: 0 auto 3rem; text-align: center;">
        Whether you need a SaaS platform, a record label, a visual identity, or
        all four — we'd like to hear from you.
      </p>
      <a href="mailto:studio@visualgv.com" class="contact-email reveal">
        studio@visualgv.com
      </a>
    </div>
  </section>

  <!-- ─── Footer ─── -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-logo">VISUAL<span>GV</span></div>
          <p>A creative technology studio building software, music, photography, and design from New York City.</p>
        </div>
        <div class="footer-col">
          <h4>Practice</h4>
          <a href="#practice">SaaS</a>
          <a href="#practice">Music & Artists</a>
          <a href="#practice">Photography</a>
          <a href="#practice">Graphic Design</a>
        </div>
        <div class="footer-col">
          <h4>Studio</h4>
          <a href="#philosophy">Philosophy</a>
          <a href="#works">Works</a>
          <a href="#contact">Contact</a>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <p>studio@visualgv.com</p>
          <p>New York, NY</p>
          <p>By appointment</p>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 VISUALGV. All rights reserved.</span>
        <span>Designed & engineered in-house.</span>
      </div>
    </div>
  </footer>
</Layout>
